# Kopieren nach .env und anpassen. Die .env-Datei niemals einchecken.
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
# Name oder IP, unter der das NAS im Praxisnetz erreichbar ist
PHYSIOFLOW_HOST=physioflow.local

PHYSIOFLOW_TIMEZONE=Europe/Berlin

# Optionale lokale Assistenz (leer lassen = aus). Es werden nur Adressen im Praxisnetz akzeptiert,
# z. B. ein Rechner mit Ollama (Textvorschläge) und einem OpenAI-kompatiblen Whisper-Server (Sprache).
PHYSIOFLOW_LLM_URL=
PHYSIOFLOW_LLM_MODEL=llama3.1
PHYSIOFLOW_WHISPER_URL=

# Handschrifterkennung: lokales Bild-Sprachmodell (OpenAI-kompatibel, z. B. Ollama). Ohne Modellname ist die Funktion aus.
# Adresse leer = PHYSIOFLOW_LLM_URL verwenden. Modell vorher mit eigener Handschrift ausprobieren!
PHYSIOFLOW_VISION_URL=
PHYSIOFLOW_VISION_MODEL=
